# Groq API key (used for summarization, extraction, and RAG Q&A)
GROQ_API_KEY="your_groq_api_key_here"

# Local OpenAI Whisper model size for English transcription (tiny, base, small, medium, large)
WHISPER_MODEL="small"

# Sarvam AI API key & model (used for Hinglish speech-to-text-translate)
SARVAM_API_KEY="your_sarvam_api_key_here"
SARVAM_STT_MODEL="saaras:v4"
